{
  "server": {
    "host": "0.0.0.0",
    "port": 8081,
    "tls": {
      "enabled": true,
      "cert": "${ANUBIS_TLS_CERT}",
      "key": "${ANUBIS_TLS_KEY}",
      "min_version": 3,
      "prefer_server": true
    }
  },
  "storage": {
    "path": "./data/prod",
    "encryption": {
      "enabled": true,
      "key": "${ANUBIS_ENCRYPTION_KEY}"
    }
  },
  "auth": {
    "enabled": true,
    "type": "local",
    "local": {
      "admin_email": "admin@anubis.watch",
      "admin_password": "${ANUBIS_ADMIN_PASSWORD}"
    }
  },
  "necropolis": {
    "enabled": false
  },
  "dashboard": {
    "enabled": true,
    "branding": {
      "theme": "dark"
    }
  },
  "logging": {
    "level": "info",
    "format": "json"
  }
}
